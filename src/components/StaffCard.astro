---
import { Image } from 'astro:assets';
// The bio is the staff file's Markdown body, passed in as the default slot.
interface Props {
  name: string;
  role: string;
  photo?: ImageMetadata;
  photoPosition?: string;
}
const { name, role, photo, photoPosition } = Astro.props;
---

<article class="staff-card">
  <div class="staff-photo">
    {photo ? (
      <Image
        src={photo}
        alt={`${name} — ${role}`}
        width={400}
        height={400}
        class="staff-img"
        style={photoPosition ? `object-position: ${photoPosition}` : undefined}
      />
    ) : (
      <div class="staff-initial" aria-hidden="true">{name.charAt(0)}</div>
    )}
  </div>
  <h3>{name}</h3>
  <p class="staff-role">{role}</p>
  {Astro.slots.has('default') && <div class="staff-bio"><slot /></div>}
</article>

<style>
  .staff-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }
  .staff-photo {
    border-radius: var(--radius-sm);
    overflow: hidden;
    aspect-ratio: 1;
    background: var(--navy-100);
    margin-bottom: 0.85rem;
  }
  .staff-img { width: 100%; height: 100%; object-fit: cover; margin: 0; }
  .staff-initial {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.5rem;
    color: var(--navy-700);
  }
  .staff-card h3 { margin: 0 0 0.15rem; font-size: 1.15rem; }
  .staff-role {
    margin: 0 0 0.6rem;
    color: var(--gold-700);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-family: var(--font-display);
  }
  .staff-bio { font-size: 0.92rem; color: var(--text-soft); }
  .staff-bio :global(p),
  .staff-bio :global(ul) { margin: 0 0 0.6rem; }
  .staff-bio :global(:last-child) { margin-bottom: 0; }
</style>
