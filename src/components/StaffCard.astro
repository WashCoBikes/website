---
import { Image } from 'astro:assets';
interface Props {
  name: string;
  role: string;
  bio?: string;
  photo?: ImageMetadata;
}
const { name, role, bio, photo } = Astro.props;
---

<article class="staff-card">
  <div class="staff-photo">
    {photo ? (
      <Image src={photo} alt={`${name} — ${role}`} width={400} height={400} class="staff-img" />
    ) : (
      <div class="staff-initial" aria-hidden="true">{name.charAt(0)}</div>
    )}
  </div>
  <h3>{name}</h3>
  <p class="staff-role">{role}</p>
  {bio && <p class="staff-bio">{bio}</p>}
</article>

<style>
  .staff-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }
  .staff-photo {
    border-radius: var(--radius-sm);
    overflow: hidden;
    aspect-ratio: 1;
    background: var(--navy-100);
    margin-bottom: 0.85rem;
  }
  .staff-img { width: 100%; height: 100%; object-fit: cover; }
  .staff-initial {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.5rem;
    color: var(--navy-700);
  }
  .staff-card h3 { margin: 0 0 0.15rem; font-size: 1.15rem; }
  .staff-role {
    margin: 0 0 0.6rem;
    color: var(--gold-700);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-family: var(--font-display);
  }
  .staff-bio { margin: 0; font-size: 0.92rem; color: var(--text-soft); white-space: pre-line; }
</style>
