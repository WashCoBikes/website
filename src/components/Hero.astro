---
// The site's one hero banner: the homepage, and any content page that sets
// `heroImage` in its frontmatter. Buttons go in the default slot.
import { Image } from 'astro:assets';

interface Props {
  title: string;
  lede?: string;
  eyebrow?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, lede, eyebrow, image, imageAlt = '' } = Astro.props;
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lede && <p class="hero-body">{lede}</p>}
      {Astro.slots.has('default') && <div class="hero-cta"><slot /></div>}
    </div>
    <div class="hero-media">
      {image && <Image src={image} alt={imageAlt} class="hero-img" loading="eager" />}
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(160deg, var(--navy-900) 0%, var(--navy-800) 55%, var(--navy-700) 100%);
    color: #fff;
    padding: clamp(2.5rem, 6vw, 5rem) 0;
    position: relative;
    overflow: hidden;
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 80% at 85% 20%, rgba(255, 188, 25, 0.18), transparent 60%);
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .hero-eyebrow {
    color: var(--gold-400);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.82rem;
    margin-bottom: 0.75rem;
  }
  .hero-copy h1 { color: #fff; margin-bottom: 0.5rem; }
  .hero-body {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.85);
    max-width: 34ch;
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .hero-media { display: flex; justify-content: center; }
  .hero-img {
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 30rem;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 4px solid rgba(255, 255, 255, 0.12);
  }

  @media (min-width: 700px) {
    .hero-grid { grid-template-columns: 1.05fr 0.95fr; }
  }
</style>
