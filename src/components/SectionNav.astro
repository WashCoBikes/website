---
// Section nav for sectioned pages (Saddle Up, Education, Join/Donate, etc.).
// Renders pills that link to the on-page anchors defined in frontmatter.
interface Props {
  sections: { id: string; label: string }[];
}
const { sections } = Astro.props;
---

<nav class="section-nav" aria-label="On this page">
  <ul class="section-nav-list">
    {sections.map((s) => (
      <li><a href={`#${s.id}`}>{s.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .section-nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .section-nav-list a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--navy-100);
    color: var(--navy-800);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    font-family: var(--font-display);
    transition: background 0.12s ease, color 0.12s ease;
  }
  .section-nav-list a:hover {
    background: var(--navy-800);
    color: #fff;
  }
</style>
