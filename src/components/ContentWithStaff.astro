---
// Renders a page's Markdown body and swaps each staff slot marker
// (<div data-staff-slot="instructor"></div>) for that group's staff cards.
//
// The body arrives as the default slot (<Content />), so Astro renders it
// fully first — including its image processing — before we split it. Splitting
// the raw `page.rendered.html` instead skips that step and leaves images as
// unresolved placeholders.
import { getCollection } from 'astro:content';
import StaffCard from './StaffCard.astro';

interface StaffSection {
  id: string;
  label: string;
  staffGroup?: 'mechanic' | 'instructor';
}

interface Props {
  sections?: StaffSection[];
}

const staffSections = (Astro.props.sections ?? []).filter((s) => s.staffGroup);
const staff = await getCollection('staff');

type Chunk =
  | { type: 'html'; html: string }
  | { type: 'staff'; id: string; label: string; group: string };

const chunks: Chunk[] = [];
let rest = await Astro.slots.render('default');
for (const s of staffSections) {
  const marker = `<div data-staff-slot="${s.staffGroup}"></div>`;
  const idx = rest.indexOf(marker);
  if (idx === -1) continue;
  chunks.push({ type: 'html', html: rest.slice(0, idx) });
  chunks.push({ type: 'staff', id: s.id, label: s.label, group: s.staffGroup! });
  rest = rest.slice(idx + marker.length);
}
chunks.push({ type: 'html', html: rest });
---

{chunks.map((chunk) =>
  chunk.type === 'html' ? (
    <Fragment set:html={chunk.html} />
  ) : (
    <section class="staff-section">
      <h2 id={chunk.id}>{chunk.label}</h2>
      <div class="grid grid--3">
        {staff
          .filter((m) => m.data.group === chunk.group)
          .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
          .map((m) => (
            <StaffCard
              name={m.data.name}
              role={m.data.role}
              bio={m.data.bio}
              photo={m.data.photo}
            />
          ))}
      </div>
    </section>
  ),
)}

<style>
  .staff-section { margin-top: 2.5rem; }
  .staff-section h2 { scroll-margin-top: calc(var(--header-h) + 1rem); }
</style>
