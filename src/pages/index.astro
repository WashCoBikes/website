---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const images = import.meta.glob('../assets/images/*.{png,jpg,jpeg,webp}', {
  eager: true,
  import: 'default',
});
function resolveImage(name: string) {
  return images[`../assets/images/${name}`];
}
const heroImg = resolveImage(site.hero.image);
// Collapse consecutive days with the same hours: "Monday – Saturday".
const hourGroups: { days: string; time: string }[] = [];
for (const d of site.hours.days) {
  const time = d.close ? `${d.open} – ${d.close}` : d.open;
  const last = hourGroups.at(-1);
  if (last && last.time === time) {
    last.days = `${last.days.split(' – ')[0]} – ${d.day}`;
  } else {
    hourGroups.push({ days: d.day, time });
  }
}

// The body below the promo is Markdown, editable like any other page.
const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');
const { Content } = await render(home);
---

<BaseLayout title={site.name}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="hero-eyebrow">Washington County · Oregon</p>
        <h1>{site.hero.heading}</h1>
        <p class="hero-body">{site.hero.body}</p>
        <div class="hero-cta">
          <a class="btn btn--primary" href={site.hero.cta.href}>{site.hero.cta.label}</a>
          <a class="btn btn--ghost-light" href="/contact">Contact Us</a>
        </div>
      </div>
      <div class="hero-media">
        {heroImg ? (
          <Image src={heroImg} alt="Cyclists on a community ride" class="hero-img" loading="eager" />
        ) : null}
      </div>
    </div>
  </section>

  <section class="promo" aria-label="Current promo">
    <div class="wrap promo-inner">
      <div class="promo-copy">
        <p class="promo-kicker">Now · {site.promo.heading}</p>
        <ul class="promo-details">
          {site.promo.details.map((d) => <li>{d}</li>)}
        </ul>
        <p class="promo-body">{site.promo.body}</p>
      </div>
      <div class="promo-action">
        <a class="btn btn--primary" href={site.promo.cta.href} target="_blank" rel="noopener">
          {site.promo.cta.label}
        </a>
      </div>
    </div>
  </section>

  <section class="home-body">
    <div class="wrap prose">
      <Content />
    </div>
  </section>

  <section class="visit-band" aria-labelledby="visit">
    <div class="wrap visit-band-inner">
      <div class="visit-band-copy">
        <h2 id="visit">Visit us in Hillsboro</h2>
        <p>
          {site.address.street}, {site.address.city}, {site.address.state} {site.address.zip}
          <span aria-hidden="true"> · </span>
          <a href={`tel:+1${site.phone.replace(/[^0-9]/g, '')}`}>{site.phone}</a>
          <span aria-hidden="true"> · </span>
          <a href={`mailto:${site.shopEmail}`}>{site.shopEmail}</a>
        </p>
        <ul class="visit-band-hours">
          {hourGroups.map((g) => (
            <li><strong>{g.days}:</strong> {g.time}</li>
          ))}
        </ul>
      </div>
      <a class="btn btn--primary" href="/shop">Retail Shop</a>
    </div>
  </section>

  <section class="events-band">
    <div class="wrap events-band-inner">
      <h2>Classes, rides, clinics &amp; community events.</h2>
      <a class="btn btn--primary" href="/events">See upcoming events</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(160deg, var(--navy-900) 0%, var(--navy-800) 55%, var(--navy-700) 100%);
    color: #fff;
    padding: clamp(2.5rem, 6vw, 5rem) 0;
    position: relative;
    overflow: hidden;
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 80% at 85% 20%, rgba(255, 188, 25, 0.18), transparent 60%);
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .hero-eyebrow {
    color: var(--gold-400);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.82rem;
    margin-bottom: 0.75rem;
  }
  .hero-copy h1 { color: #fff; margin-bottom: 0.5rem; }
  .hero-body {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.85);
    max-width: 34ch;
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .hero-media { display: flex; justify-content: center; }
  .hero-img {
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 30rem;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 4px solid rgba(255, 255, 255, 0.12);
  }

  .promo { padding: 1.5rem 0; }
  .promo-inner {
    display: grid;
    gap: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 6px solid var(--gold-500);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .promo-kicker {
    color: var(--navy-700);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }
  .promo-details { margin: 0 0 0.75rem; padding: 0; list-style: none; }
  .promo-details li { margin-bottom: 0.25rem; font-weight: 500; }
  .promo-body { margin: 0 0 1rem; color: var(--text-soft); }
  .promo-action { display: flex; align-items: center; }

  .home-body { padding: 1.5rem 0 1rem; }
  /* .prose caps width at 46rem for readable line length, which also squeezed
     the card grid. Let the homepage body use the full page width, and keep
     only the running text at a readable measure. */
  .home-body .prose { max-width: var(--maxw); }
  .home-body .prose > :global(:not(.grid)) { max-width: 46rem; }

  .visit-band { background: var(--navy-800); color: #fff; padding: 2rem 0; }
  .visit-band-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .visit-band h2 { color: #fff; margin: 0 0 0.35rem; scroll-margin-top: calc(var(--header-h) + 1rem); }
  .visit-band p { margin: 0 0 0.5rem; color: rgba(255, 255, 255, 0.85); }
  .visit-band a:not(.btn) { color: #fff; white-space: nowrap; }
  .visit-band-hours { list-style: none; margin: 0; padding: 0; }
  .visit-band-hours strong { color: var(--gold-400); }

  .events-band { background: var(--navy-900); color: #fff; padding: 2rem 0; }
  .events-band-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .events-band h2 { color: #fff; margin: 0; }

  @media (min-width: 700px) {
    .hero-grid { grid-template-columns: 1.05fr 0.95fr; }
  }
</style>
