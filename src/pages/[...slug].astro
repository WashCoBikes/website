---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionNav from '../components/SectionNav.astro';
import ContentWithStaff from '../components/ContentWithStaff.astro';
import ChildLinks from '../components/ChildLinks.astro';
import Hero from '../components/Hero.astro';
import HoursWidget from '../components/HoursWidget.astro';
import RatesWidget from '../components/RatesWidget.astro';
import site from '../data/site.json';
import { generatedChildren } from '../lib/nav';

export async function getStaticPaths() {
  // "home" is the homepage body; src/pages/index.astro renders it at /.
  const pages = await getCollection(
    'pages',
    ({ data }) => !data.draft && data.slug !== 'home',
  );
  return pages.map((page) => ({
    params: { slug: page.data.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);

// Section landing pages link to the pages beneath them. Slugs are hierarchical,
// so children are everything one level down; routes that render generated
// content aren't in the collection and come from `generatedChildren`.
const slug = page.data.slug;
const allPages = await getCollection('pages', ({ data }) => !data.draft);
const childLinks = [
  ...allPages
    .filter((p) => {
      const rest = p.data.slug.startsWith(`${slug}/`)
        ? p.data.slug.slice(slug.length + 1)
        : null;
      return rest !== null && !rest.includes('/');
    })
    .map((p) => ({ label: p.data.title, href: `/${p.data.slug}` })),
  ...(generatedChildren[slug] ?? []),
].sort((a, b) => a.label.localeCompare(b.label));

const sections = page.data.sections ?? [];
const navSections = sections.map(({ id, label }) => ({ id, label }));

const { heroImage, showHours, showRates, description } = page.data;
const tel = `tel:+1${site.phone.replace(/[^0-9]/g, '')}`;
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${site.address.street}, ${site.address.city}, ${site.address.state} ${site.address.zip}`,
)}`;
---

<BaseLayout title={page.data.title} description={description || undefined}>
  {heroImage && (
    <Hero
      title={page.data.title}
      lede={description}
      eyebrow={showHours ? `${site.address.street} · ${site.address.city}, ${site.address.state}` : undefined}
      image={heroImage}
      imageAlt={`${page.data.title} photo`}
    >
      {showHours && (
        <>
          <a class="btn btn--primary" href={tel}>Call {site.phone}</a>
          <a class="btn btn--ghost-light" href={directions} target="_blank" rel="noopener">Get directions</a>
        </>
      )}
    </Hero>
  )}

  <article class="wrap page">
    {(!heroImage || navSections.length > 0) && (
      <header class="page-head">
        {!heroImage && <h1 class="page-title">{page.data.title}</h1>}
        {navSections.length > 0 && <SectionNav sections={navSections} />}
      </header>
    )}

    <div class:list={['page-body', { 'page-body--aside': showHours }]}>
      <div class="prose">
        <ContentWithStaff sections={sections}>
          <Content />
        </ContentWithStaff>
        {showRates && <RatesWidget />}
      </div>
      {showHours && (
        <aside class="page-aside" aria-label="Shop location and hours">
          <HoursWidget />
        </aside>
      )}
    </div>

    <ChildLinks children={childLinks} />
  </article>
</BaseLayout>

<style>
  .page { padding-top: 2rem; padding-bottom: 3rem; }
  .page-head { margin-bottom: 1rem; }
  .page-title { margin-bottom: 0.25rem; }
  /* .prose caps width at 46rem for readable line length. Staff card sections
     run the full page width; everything else keeps the readable measure.
     Same approach as the homepage body. Pages with the hours sidebar keep
     the narrow column. */
  .page-body:not(.page-body--aside) .prose { max-width: none; }
  .page-body:not(.page-body--aside) .prose > :global(:not(.staff-section)) { max-width: 46rem; }
  .page-body--aside { display: grid; gap: 2rem; }
  @media (min-width: 900px) {
    .page-body--aside {
      grid-template-columns: minmax(0, 46rem) 20rem;
      gap: 3rem;
      align-items: start;
    }
    .page-aside { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  }
</style>
